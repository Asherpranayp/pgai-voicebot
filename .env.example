# --- LiveKit Cloud (Settings -> Keys in your LiveKit Cloud project) ---
LIVEKIT_URL=wss://your-project-xxxxxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- LiveKit outbound SIP trunk (created once via app/create_sip_trunk.py,
# backed by a Twilio Elastic SIP Trunk) ---
SIP_TRUNK_ID=ST_xxxxxxxxxxxx
TARGET_NUMBER=+18054398008           # Pretty Good AI test line — do not change

# --- Twilio Elastic SIP Trunk credentials (used only by app/create_sip_trunk.py
# to configure the trunk once; not read by the agent itself) ---
SIP_TRUNK_ADDRESS=your-domain.pstn.twilio.com
SIP_TRUNK_FROM_NUMBER=+19205515133   # your Twilio number, E.164 format
SIP_TRUNK_USERNAME=your_sip_credential_username
SIP_TRUNK_PASSWORD=your_sip_credential_password

# --- OpenAI (pipeline mode: separate STT / LLM / TTS calls, no realtime API) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx

# --- Optional: Deepgram streaming speech-to-text (lower latency than Whisper). ---
# Leave empty to use OpenAI Whisper for STT.
DEEPGRAM_API_KEY=
# With a Deepgram key, the patient's voice also uses Deepgram Aura-2 TTS (lower latency).
# Set TTS_PROVIDER=openai to keep OpenAI TTS instead.
# Patient voice: male (the test patient, Asher, is male).
DEEPGRAM_TTS_MODEL=aura-2-orion-en

AGENT_NAME=pgai-voicebot-agent

# --- Test patient identity (used by the bot when the agent asks for details) ---
PATIENT_NAME=Asher Pranay Palle
PATIENT_DOB=1995-02-16
